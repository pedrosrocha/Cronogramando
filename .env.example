POSTGRES_USER=cronogramando
POSTGRES_PASSWORD=changeme
POSTGRES_DB=cronogramando
DATABASE_URL=postgres://cronogramando:changeme@postgres:5432/cronogramando
JWT_SECRET=change-me-in-production
ACCESS_TOKEN_TTL_SECS=900
REFRESH_TOKEN_TTL_SECS=2592000
ADMIN_EMAIL=admin@cronogramando.local
ADMIN_PASSWORD=changeme123

# LLM provider (OpenAI-compatible). OpenRouter exposes every model below.
LLM_BASE_URL=https://openrouter.ai/api/v1
LLM_API_KEY=
LLM_TIMEOUT_SECS=90
LLM_MAX_RETRIES=2

# Goal -> books. Comma-separated fallbacks are tried in order.
LLM_DECOMPOSER_MODEL=dots-studio/dots-3-note-preview:free
LLM_DECOMPOSER_FALLBACK_MODELS=recursive/flint-v1.0:free,google/gemma-4-31b-it:free

# Book -> steps/activities.
LLM_PLANNER_MODEL=dots-studio/dots-3-note-preview:free
LLM_PLANNER_FALLBACK_MODELS=recursive/flint-v1.0:free,google/gemma-4-31b-it:free

# PDF block translation (pt-BR <-> en).
LLM_TRANSLATOR_MODEL=nvidia/nemotron-3.5-lightning:free
LLM_TRANSLATOR_FALLBACK_MODELS=google/gemma-4-26b-a4b-it:free,google/gemma-4-31b-it:free

# Relevance judge and micro-lesson tutor (blank = reuse the planner model).
LLM_CURATOR_MODEL=
LLM_CURATOR_FALLBACK_MODELS=
LLM_TUTOR_MODEL=
LLM_TUTOR_FALLBACK_MODELS=

# Optional per-role provider overrides; blank means "use the shared LLM_* value".
LLM_DECOMPOSER_BASE_URL=
LLM_DECOMPOSER_API_KEY=
LLM_PLANNER_BASE_URL=
LLM_PLANNER_API_KEY=
LLM_TRANSLATOR_BASE_URL=
LLM_TRANSLATOR_API_KEY=

# Optional per-role timeout/retry overrides; blank means "use the shared LLM_* value".
LLM_DECOMPOSER_TIMEOUT_SECS=
LLM_DECOMPOSER_MAX_RETRIES=
LLM_PLANNER_TIMEOUT_SECS=
LLM_PLANNER_MAX_RETRIES=
LLM_TRANSLATOR_TIMEOUT_SECS=
LLM_TRANSLATOR_MAX_RETRIES=

YOUTUBE_API_KEY=
YOUTUBE_DAILY_UNITS=10000
CONNECTOR_TIMEOUT_SECS=5

# Content quality: self-hosted SearXNG web search.
CONTENT_WEB_SEARCH_PROVIDER=searxng
SEARXNG_URL=http://127.0.0.1:8082
SEARXNG_ENGINES=bing
SEARXNG_LANGUAGE=pt-BR
SEARXNG_MAX_RESULTS=10
SEARXNG_TIMEOUT_SECS=10

# Content quality: hard gates and judge.
CONTENT_VERIFY_TOP_K=3
CONTENT_MAX_PDF_PAGES=30
CONTENT_MAX_PDF_BYTES=15728640
CONTENT_MIN_ARTICLE_WORDS=300
CONTENT_MAX_ARTICLE_WORDS=3000
CONTENT_MIN_VIDEO_SECS=180
CONTENT_MAX_VIDEO_SECS=1200
CONTENT_CURATOR_MODE=ambiguous
CONTENT_FALLBACK_LESSON=auto
CONTENT_JUDGE_THRESHOLD=7
CONTENT_JUDGE_MARGIN_PCT=15
CONTENT_JUDGE_TIMEOUT_SECS=45
CONTENT_TUTOR_TIMEOUT_SECS=45

PDF_SERVICE_URL=http://localhost:8001
PDF_SERVICE_TIMEOUT_SECS=180
PDF_MAX_BYTES=67108864
PDF_TABLE_DETECTION=auto
PDF_TABLE_FINDER_MAX_PAGES=20
